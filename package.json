{
  "name": "darkest-dungeon-advisor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The town advisor for a Darkest Dungeon playthrough: reads the game's data and a copy of the save, and advises between expeditions, only from what the player has seen.",
  "scripts": {
    "read": "bun src/read.ts",
    "town": "bun src/cli.ts town",
    "watch": "bun src/cli.ts watch",
    "skin": "bun src/skin.ts",
    "live": "bun src/live.ts",
    "say": "bun src/road.ts say",
    "now": "bun src/now.ts",
    "caretaker": "bun src/caretaker.ts",
    "ship": "bun src/ship.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.6.0"
  }
}
